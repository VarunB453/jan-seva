# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_DB=janseva
POSTGRES_USER=janseva
POSTGRES_PASSWORD=replace_with_a_random_hex_password
DATABASE_URL=postgresql://janseva:replace_with_a_random_hex_password@db:5432/janseva?schema=public
JWT_SECRET=replace_with_at_least_32_random_bytes

# Public browser URL; set both to your HTTPS origin in production.
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
HTTP_PORT=8080

# Optional email delivery. Configure one supported provider for production.
RESEND_API_KEY=
RESEND_FROM=
EMAIL_USER=
EMAIL_PASS=
